# ZapUPI — set real values as Railway secrets; never put the API key in the Android app.
ZAPUPI_API_KEY=
ZAPUPI_WEBHOOK_URL=https://turnament-1-storage-production.up.railway.app/api/payments/zapupi/webhook
# Optional ceiling, in INR. Backend default is 100000.
ZAPUPI_MAX_AMOUNT_INR=100000
# Keep false in production; test environment transactions are not credited by default.
ZAPUPI_ALLOW_TEST_PAYMENTS=false
